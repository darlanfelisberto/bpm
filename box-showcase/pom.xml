<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.edu.iffar</groupId>
        <artifactId>bpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>box-showcase</artifactId>
    <packaging>war</packaging>

    <name>box-showcase</name>
    <description>Vitrine dos componentes da lib box: uma pagina de demonstracao (exemplo ao vivo + trecho de
        uso) por componente, e onde ficam os testes end-to-end que garantem o funcionamento deles. Sem banco
        de dados - os componentes do box nao precisam de persistencia.</description>

    <properties>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <!-- Verificar no Maven Central se ha versoes mais recentes antes do build -->
        <version.liberty-maven-plugin>3.11.2</version.liberty-maven-plugin>
        <version.build-helper-plugin>3.6.1</version.build-helper-plugin>

        <!-- Porta diferente da do bpm-app (9080/9443): da pra rodar os dois
             servidores ao mesmo tempo sem conflito. -->
        <liberty.var.default.http.port>9081</liberty.var.default.http.port>
        <liberty.var.default.https.port>9444</liberty.var.default.https.port>
    </properties>

    <dependencies>
        <!-- box: componentes Jakarta Faces deste reactor, o que esta sendo vitrinado -->
        <dependency>
            <groupId>br.edu.iffar</groupId>
            <artifactId>box</artifactId>
        </dependency>

        <!-- Jakarta EE 11 Web Profile: CDI, Faces, Bean Validation, etc. -->
        <!-- Fornecido em runtime pelo Open Liberty; usado apenas para compilacao. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>${version.jakartaee-api}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Faces 4.1 (parte administrativa) -->
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>box-showcase</finalName>
        <plugins>
            <!-- Executa/empacota a aplicacao no Open Liberty (mvn liberty:dev /
                 liberty:run pra uso manual, primeiro plano). O profile e2e
                 (ver <profiles> abaixo) adiciona execucoes start/stop pros
                 testes end-to-end. -->
            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
                <version>${version.liberty-maven-plugin}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Testes end-to-end dos componentes do box (src/e2e-test/java,
             Playwright): isolados num profile em vez de ligados direto no
             build pelo mesmo motivo documentado em bpm-app (antes de mover
             pra ca) - a fase verify vem ANTES de install no ciclo de vida
             padrao do Maven, entao sem isolar todo "mvn install" subiria/
             derrubaria um Liberty de verdade so pra compilar. Ativar com
             "mvn verify -Pe2e" (ver BUILD.md). -->
        <profile>
            <id>e2e</id>
            <dependencies>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>com.microsoft.playwright</groupId>
                    <artifactId>playwright</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${version.build-helper-plugin}</version>
                        <executions>
                            <execution>
                                <id>adicionar-fonte-dos-testes-e2e</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/e2e-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.openliberty.tools</groupId>
                        <artifactId>liberty-maven-plugin</artifactId>
                        <executions>
                            <!-- liberty:start sozinho nao cria o servidor, nao
                                 resolve as features do server.xml nem copia o
                                 WAR pro servidor (diferente de liberty:run/dev,
                                 que encadeiam create + install-feature + deploy
                                 por baixo dos panos) - sem estes passos o
                                 servidor "inicia" sem feature nenhuma instalada
                                 e/ou sem a aplicacao implantada, apesar do log
                                 dizer "pronto" (ver historico no bpm-app antes
                                 desta mudanca). -->
                            <execution>
                                <id>criar-servidor-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>create</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>resolver-features-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>install-feature</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>implantar-war-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>deploy</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>subir-servidor-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>derrubar-servidor-depois-dos-testes-e2e</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
