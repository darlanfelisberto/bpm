<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.edu.iffar</groupId>
        <artifactId>bpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>box-showcase</artifactId>
    <packaging>war</packaging>

    <name>box-showcase</name>
    <description>Showcase of the box lib components: one demonstration page (live example + usage snippet)
        per component, and where the end-to-end tests that guarantee they work live. No database - box
        components don't need persistence.</description>

    <properties>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <!-- Check Maven Central for newer versions before building -->
        <version.liberty-maven-plugin>3.11.2</version.liberty-maven-plugin>
        <version.build-helper-plugin>3.6.1</version.build-helper-plugin>

        <!-- Different port than bpm-app (9080/9443): both servers can run
             at the same time without conflict. -->
        <liberty.var.default.http.port>9081</liberty.var.default.http.port>
        <liberty.var.default.https.port>9444</liberty.var.default.https.port>
    </properties>

    <dependencies>
        <!-- box: Jakarta Faces components from this reactor, what's being showcased -->
        <dependency>
            <groupId>br.edu.iffar</groupId>
            <artifactId>box</artifactId>
        </dependency>

        <!-- Jakarta EE 11 Web Profile: CDI, Faces, Bean Validation, etc. -->
        <!-- Provided at runtime by Open Liberty; only used here to compile. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>${version.jakartaee-api}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Faces 4.1 (build-time bookkeeping) -->
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>box-showcase</finalName>
        <plugins>
            <!-- Runs/packages the application on Open Liberty (mvn liberty:dev /
                 liberty:run for manual use, foreground). The e2e profile
                 (see <profiles> below) adds start/stop executions for the
                 end-to-end tests. -->
            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
                <version>${version.liberty-maven-plugin}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- End-to-end tests for the box components (src/e2e-test/java,
             Playwright): isolated in a profile instead of wired directly
             into the build for the same reason documented in bpm-app
             (before this moved here) - the verify phase comes BEFORE
             install in Maven's default lifecycle, so without isolating
             it every "mvn install" would spin up/tear down a real
             Liberty server just to compile. Activate with
             "mvn verify -Pe2e" (see BUILD.md). -->
        <profile>
            <id>e2e</id>
            <dependencies>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>com.microsoft.playwright</groupId>
                    <artifactId>playwright</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${version.build-helper-plugin}</version>
                        <executions>
                            <execution>
                                <id>add-e2e-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/e2e-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.openliberty.tools</groupId>
                        <artifactId>liberty-maven-plugin</artifactId>
                        <executions>
                            <!-- liberty:start alone doesn't create the server, doesn't
                                 resolve the server.xml features, and doesn't copy the
                                 WAR to the server (unlike liberty:run/dev, which chain
                                 create + install-feature + deploy under the hood) -
                                 without these steps the server "starts" with no
                                 feature installed and/or no application deployed,
                                 despite the log saying "ready" (see the bpm-app
                                 history before this change). -->
                            <execution>
                                <id>create-server-before-e2e-tests</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>create</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>resolve-features-before-e2e-tests</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>install-feature</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>deploy-war-before-e2e-tests</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>deploy</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>start-server-before-e2e-tests</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>stop-server-after-e2e-tests</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
