<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.iffar</groupId>
    <artifactId>bpm-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IFFar BPM (reactor)</name>
    <description>Agregador Maven: biblioteca de componentes JSF reutilizavel (box) + aplicacao web (bpm-app)</description>

    <modules>
        <module>box</module>
        <module>bpm-app</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Verificar no Maven Central se ha versoes mais recentes antes do build -->
        <version.jakartaee-api>11.0.0</version.jakartaee-api>
        <version.faces-api>4.1.0</version.faces-api>
        <version.el-api>6.0.1</version.el-api>
        <version.jsoup>1.18.1</version.jsoup>
        <version.download-maven-plugin>1.13.0</version.download-maven-plugin>
        <version.junit-bom>6.1.3</version.junit-bom>
        <version.surefire-plugin>3.5.6</version.surefire-plugin>

        <!-- Bibliotecas JS/CSS de terceiros baixadas no build (nao versionadas -
             ver plugin download-maven-plugin em box/pom.xml e bpm-app/pom.xml).
             Trocar a versao aqui e rodar o build de novo e o suficiente pra
             atualizar; o sha256 abaixo precisa ser atualizado junto (o build
             falha se nao bater, evitando trocar o arquivo por engano). -->
        <version.quill>2.0.3</version.quill>
        <quill.js.sha256>f6157c72ac9b3f51cdead426335688a027b12405d9d6a4daadd38a676b2d7ff2</quill.js.sha256>
        <quill.css.sha256>1c7948cd13aa92fac6390319bc1e5e461823da171519d3a768db56164f871636</quill.css.sha256>

        <version.bootstrap-icons>1.11.3</version.bootstrap-icons>
        <bootstrap-icons.css.sha256>4ffa6bea4304d2eda418683f56261685ed47bf00995039f27e5ad62d53938d2d</bootstrap-icons.css.sha256>
        <bootstrap-icons.woff.sha256>bb1de989b83970f6f4e54de1cd974c5cba55b73582da5e1b225a6d0edf029483</bootstrap-icons.woff.sha256>
        <bootstrap-icons.woff2.sha256>476adf42b40325098fcfa8b36ab3e769186bb4f6ce6a249753e2e1a9c22bf99e</bootstrap-icons.woff2.sha256>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- box: biblioteca de componentes Jakarta Faces deste reactor -->
            <dependency>
                <groupId>br.edu.iffar</groupId>
                <artifactId>box</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Jakarta Faces 4.1: fornecido em runtime pelo Open Liberty, usado
                 apenas para compilacao (tanto em box quanto em bpm-app). -->
            <dependency>
                <groupId>jakarta.faces</groupId>
                <artifactId>jakarta.faces-api</artifactId>
                <version>${version.faces-api}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Jsoup: sanitizacao de HTML (box:editor), unico ponto de
                 defesa contra XSS armazenado no conteudo submetido. -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${version.jsoup}</version>
            </dependency>

            <!-- JUnit 5: testes unitarios (ex.: box/src/test, sanitizacao do
                 b:editor). BOM alinha as versoes de todos os artefatos
                 junit-jupiter-*. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${version.junit-bom}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${version.surefire-plugin}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
