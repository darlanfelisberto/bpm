<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.edu.iffar</groupId>
        <artifactId>bpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>box</artifactId>
    <packaging>jar</packaging>

    <name>box</name>
    <description>Native Jakarta Faces components and behaviors, reusable across IFFar projects</description>

    <dependencies>
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>${version.el-api}</version>
            <scope>provided</scope>
        </dependency>
        <!-- JSON-P: serializes b:schedule's events into the JSON FullCalendar
             reads, with correct escaping (not hand-rolled) - provided at
             runtime by Open Liberty (part of webProfile-11.0/jsonp-2.1),
             only used here to compile. -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>${version.json-api}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jakarta.json-api above is just the API (the implementation comes
             from Open Liberty at runtime) - Parsson is the reference
             implementation, test-only, so Json.createReader/createArrayBuilder
             work when running unit tests outside Liberty (e.g. DatatableTest,
             filter JSON parsing). -->
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>${version.parsson}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- src/main/resources still needs to be listed (Maven's default
             disappears once <resources> is declared, hence re-listing it
             here) + the vendor/quill downloaded by the download-maven-plugin
             below, generated into target/ on every build (never versioned). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/vendor-download</directory>
            </resource>
        </resources>
        <plugins>
            <!-- Downloads Quill (JS/CSS) straight from jsdelivr on every build,
                 instead of versioning the files in git. To update: change
                 version.quill in the root pom.xml and the matching sha256
                 (the build fails if the downloaded file doesn't match the
                 expected hash, guarding against swapping the lib by
                 mistake/tampering). -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>${version.download-maven-plugin}</version>
                <executions>
                    <execution>
                        <id>download-quill-js</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/quill@${version.quill}/dist/quill.js</url>
                            <outputDirectory>${project.build.directory}/vendor-download/META-INF/resources/box/vendor/quill</outputDirectory>
                            <outputFileName>quill.js</outputFileName>
                            <sha256>${quill.js.sha256}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-quill-css</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/quill@${version.quill}/dist/quill.snow.css</url>
                            <outputDirectory>${project.build.directory}/vendor-download/META-INF/resources/box/vendor/quill</outputDirectory>
                            <outputFileName>quill.snow.css</outputFileName>
                            <sha256>${quill.css.sha256}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-fullcalendar-js</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/fullcalendar@${version.fullcalendar}/index.global.min.js</url>
                            <outputDirectory>${project.build.directory}/vendor-download/META-INF/resources/box/vendor/fullcalendar</outputDirectory>
                            <outputFileName>fullcalendar.js</outputFileName>
                            <sha256>${fullcalendar.js.sha256}</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
