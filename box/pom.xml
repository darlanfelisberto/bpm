<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.edu.iffar</groupId>
        <artifactId>bpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>box</artifactId>
    <packaging>jar</packaging>

    <name>box</name>
    <description>Componentes e behaviors Jakarta Faces nativos, reutilizaveis entre projetos do IFFar</description>

    <dependencies>
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>${version.el-api}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- src/main/resources continua valendo (comportamento padrao do Maven
             some se <resources> for declarado, por isso listado aqui de novo)
             + o vendor/quill baixado pelo download-maven-plugin abaixo, gerado
             em target/ a cada build (nunca versionado). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/vendor-download</directory>
            </resource>
        </resources>
        <plugins>
            <!-- Baixa o Quill (JS/CSS) direto do jsdelivr a cada build, em vez
                 de versionar os arquivos no git. Pra atualizar: mudar
                 version.quill no pom.xml raiz e o sha256 correspondente (o
                 build falha se o arquivo baixado nao bater com o hash
                 esperado, evitando trocar a lib por engano/adulteracao). -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>${version.download-maven-plugin}</version>
                <executions>
                    <execution>
                        <id>baixar-quill-js</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/quill@${version.quill}/dist/quill.js</url>
                            <outputDirectory>${project.build.directory}/vendor-download/META-INF/resources/box/vendor/quill</outputDirectory>
                            <outputFileName>quill.js</outputFileName>
                            <sha256>${quill.js.sha256}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>baixar-quill-css</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/quill@${version.quill}/dist/quill.snow.css</url>
                            <outputDirectory>${project.build.directory}/vendor-download/META-INF/resources/box/vendor/quill</outputDirectory>
                            <outputFileName>quill.snow.css</outputFileName>
                            <sha256>${quill.css.sha256}</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
