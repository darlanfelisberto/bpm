<?xml version="1.0" encoding="UTF-8"?>
<facelet-taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facelettaglibrary_4_0.xsd"
                 version="4.0">

    <namespace>http://iffar.edu.br/box</namespace>

    <!-- panel is registered via @FacesComponent(createTag=true); only the
         "confirm" behavior needs a manual taglib entry, since @FacesBehavior
         doesn't have that shortcut. Explicit handler-class (ConfirmHandler)
         instead of the default BehaviorHandler: the default evaluates
         "message" exactly once during view build, which breaks inside
         h:dataTable/ui:repeat. -->
    <tag>
        <tag-name>confirm</tag-name>
        <handler-class>br.edu.iffar.box.component.confirm.ConfirmHandler</handler-class>
        <attribute>
            <name>message</name>
            <required>false</required>
        </attribute>
    </tag>

    <tag>
        <tag-name>autocomplete</tag-name>
        <component>
            <component-type>br.edu.iffar.box.Autocomplete</component-type>
        </component>
        <attribute>
            <name>value</name>
            <required>false</required>
            <type>java.lang.Object</type>
        </attribute>
        <attribute>
            <name>completeMethod</name>
            <required>true</required>
            <method-signature>java.util.List complete(java.lang.String)</method-signature>
        </attribute>
        <attribute>
            <name>var</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>itemLabel</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>itemValue</name>
            <required>false</required>
            <type>java.lang.Object</type>
        </attribute>
        <attribute>
            <name>converter</name>
            <required>false</required>
            <type>jakarta.faces.convert.Converter</type>
        </attribute>
        <attribute>
            <name>minQueryLength</name>
            <required>false</required>
            <type>int</type>
        </attribute>
        <attribute>
            <name>queryDelay</name>
            <required>false</required>
            <type>int</type>
        </attribute>
        <attribute>
            <name>dropdown</name>
            <required>false</required>
            <type>boolean</type>
        </attribute>
        <attribute>
            <name>dropdownMode</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>forceSelection</name>
            <required>false</required>
            <type>boolean</type>
        </attribute>
        <attribute>
            <name>placeholder</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>emptyMessage</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>maxResults</name>
            <required>false</required>
            <type>java.lang.Integer</type>
        </attribute>
        <attribute>
            <name>disabled</name>
            <required>false</required>
            <type>boolean</type>
        </attribute>
        <attribute>
            <name>readonly</name>
            <required>false</required>
            <type>boolean</type>
        </attribute>
        <attribute>
            <name>style</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>styleClass</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>inputStyle</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
        <attribute>
            <name>inputStyleClass</name>
            <required>false</required>
            <type>java.lang.String</type>
        </attribute>
    </tag>

</facelet-taglib>
