<server description="IFFar BPM">

    <!-- webProfile-11.0 ja inclui Jakarta Faces 4.1, CDI, JPA, JAX-RS, Bean Validation -->
    <featureManager>
        <feature>webProfile-11.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}"/>

    <webApplication location="bpm.war" contextRoot="/"/>

    <!-- Driver JDBC copiado para cá pelo liberty-maven-plugin (dependency com scope adequado) -->
    <library id="postgresqlLib">
        <fileset dir="${server.config.dir}/lib/global" includes="postgresql-*.jar"/>
    </library>

    <dataSource id="DefaultDataSource" jndiName="jdbc/bpmDS">
        <jdbcDriver libraryRef="postgresqlLib"/>
        <properties.postgresql serverName="localhost" portNumber="5432"
                                databaseName="bpm"
                                user="${APP_DB_USER}" password="${APP_DB_PASSWORD}"/>
    </dataSource>

</server>
