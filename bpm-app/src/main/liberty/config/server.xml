<server description="IFFar BPM">

    <!-- Sem webProfile-11.0: ele traz persistence-3.2 (EclipseLink embutido), que
         não pode coexistir com persistenceContainer-3.2. O persistenceContainer
         só fornece a integração JPA do container; o provider (Hibernate) vem
         empacotado no WAR. -->
    <featureManager>
        <feature>faces-4.1</feature>
        <feature>cdi-4.1</feature>
        <feature>restfulWS-4.0</feature>
        <feature>jsonb-3.0</feature>
        <feature>jsonp-2.1</feature>
        <feature>validation-3.1</feature>
        <feature>jdbc-4.3</feature>
        <feature>persistence-3.2</feature>

        <!-- Para usar o Hibernate 7 -->
        <feature>xmlBinding-4.0</feature>
<!--        <feature>persistenceContainer-3.2</feature>-->
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}"/>

    <webApplication location="bpm.war" contextRoot="/">
<!--        <classloader delegation="parentLast" />-->
    </webApplication>

    <!-- Driver JDBC copiado para cá pelo liberty-maven-plugin (dependency com scope adequado) -->
    <library id="postgresqlLib">
        <fileset dir="${server.config.dir}/lib/global" includes="postgresql-*.jar"/>
    </library>

    <dataSource id="DefaultDataSource" jndiName="jdbc/bpmDS">
        <jdbcDriver libraryRef="postgresqlLib"/>
        <properties.postgresql serverName="localhost" portNumber="5432"
                                databaseName="bpm"
                                user="${APP_DB_USER}" password="${APP_DB_PASSWORD}"/>
    </dataSource>

</server>
