<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="bpmPU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>jdbc/bpmDS</jta-data-source>

        <class>br.com.feliva.bpm.model.Macroprocesso</class>
        <class>br.com.feliva.bpm.model.Processo</class>
        <class>br.com.feliva.bpm.avaliacao.model.InstrumentoAvaliativo</class>
        <class>br.com.feliva.bpm.avaliacao.model.PublicoAlvo</class>
        <class>br.com.feliva.bpm.avaliacao.model.InstrumentoSessao</class>
        <class>br.com.feliva.bpm.avaliacao.model.ConjuntoOpcao</class>
        <class>br.com.feliva.bpm.avaliacao.model.OpcaoQuestao</class>
        <class>br.com.feliva.bpm.avaliacao.model.Questao</class>
        <class>br.com.feliva.bpm.avaliacao.model.SessaoQuestao</class>
        <class>br.com.feliva.bpm.avaliacao.model.Participacao</class>
        <class>br.com.feliva.bpm.avaliacao.model.RespostaInstrumento</class>
        <class>br.com.feliva.bpm.avaliacao.model.RespostaQuestao</class>
        <class>br.com.feliva.bpm.avaliacao.model.Encaminhamento</class>

        <properties>
            <!-- O schema é responsabilidade do Flyway (src/main/resources/db/migration) -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <!-- O transformador de enhancement do Hibernate, plugado no classloader do Liberty,
                 recarrega classes recursivamente e estoura a pilha. Entidades não usam lazy de atributo. -->
<!--            <property name="hibernate.enhancer.enableDirtyTracking" value="false"/>-->
<!--            <property name="hibernate.enhancer.enableLazyInitialization" value="false"/>-->
<!--            <property name="hibernate.enhancer.enableAssociationManagement" value="false"/>-->
<!--            &lt;!&ndash; Sem isso o Hibernate não enxerga o TransactionManager do Liberty e o @Transactional não faz efeito &ndash;&gt;-->
<!--            <property name="hibernate.transaction.jta.platform"-->
<!--                      value="org.hibernate.engine.transaction.jta.platform.internal.WebSphereLibertyJtaPlatform"/>-->
        </properties>
    </persistence-unit>

</persistence>
