# Copie este arquivo para .env (nao versionado) e ajuste os valores.
# Ver bpm-app/.env para o comentario completo sobre onde essas variaveis
# sao usadas.

APP_DB_USER=postgres
APP_DB_PASSWORD=postgres

# Cliente confidencial cadastrado no provedor OIDC. Callback autorizado:
# http://localhost:9080/oidcclient/redirect/bpm
OIDC_CLIENT_ID=bpm
OIDC_CLIENT_SECRET=substitua-pelo-segredo-do-cliente
OIDC_PROVIDER_BASE_URL=http://localhost:8081/realms/bpm
# Deve ser exatamente o valor "issuer" publicado na descoberta OIDC.
OIDC_ISSUER=http://localhost:8081/realms/bpm
OIDC_REDIRECT_BASE_URL=http://localhost:9080
