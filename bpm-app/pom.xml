<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.edu.iffar</groupId>
        <artifactId>bpm-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bpm-app</artifactId>
    <packaging>war</packaging>

    <name>IFFar BPM</name>
    <description>Modelagem assistida de processos organizacionais com geracao automatica de diagrama BPMN</description>

    <properties>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <!-- Verificar no Maven Central se ha versoes mais recentes antes do build -->
        <version.liberty-maven-plugin>3.11.2</version.liberty-maven-plugin>
        <version.flyway>10.20.1</version.flyway>
        <version.postgresql>42.7.4</version.postgresql>
        <version.frontend-maven-plugin>1.15.1</version.frontend-maven-plugin>
        <version.node>v22.17.0</version.node>
        <version.build-helper-plugin>3.6.1</version.build-helper-plugin>

        <liberty.var.default.http.port>9080</liberty.var.default.http.port>
        <liberty.var.default.https.port>9443</liberty.var.default.https.port>
    </properties>

    <dependencies>
        <!-- box: componentes Jakarta Faces nativos deste reactor (ex.: b:panel) -->
        <dependency>
            <groupId>br.edu.iffar</groupId>
            <artifactId>box</artifactId>
        </dependency>

        <!-- Jakarta EE 11 Web Profile: CDI, JPA, JAX-RS, Bean Validation, Faces, etc. -->
        <!-- Fornecido em runtime pelo Open Liberty; usado apenas para compilacao. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>${version.jakartaee-api}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Faces 4.1 (parte administrativa) -->
        <dependency>
            <groupId>jakarta.faces</groupId>
            <artifactId>jakarta.faces-api</artifactId>
        </dependency>

        <!-- Driver JDBC do banco relacional (schema em src/main/resources/db/migration usa sintaxe PostgreSQL).
             scope=provided: o jar e copiado para lib/global do servidor pelo liberty-maven-plugin
             (copyDependencies), nao precisa ir empacotado dentro do WAR. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${version.postgresql}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Flyway: aplica as migrations em src/main/resources/db/migration -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${version.flyway}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${version.flyway}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>bpm</finalName>
        <plugins>
            <!-- Compila o app TypeScript/Vite em frontend/ (tela do respondente) antes
                 do empacotamento, gerando frontend/../target/responder-dist (ver
                 frontend/vite.config.ts). Baixa seu proprio Node, nao depende do
                 Node instalado na maquina. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${version.frontend-maven-plugin}</version>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${version.node}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Empacota o build do frontend (target/responder-dist) e o
                 Bootstrap Icons baixado pelo download-maven-plugin (ver
                 abaixo) dentro do WAR. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <webResources>
                        <resource>
                            <directory>${project.build.directory}/responder-dist</directory>
                            <targetPath>responder</targetPath>
                        </resource>
                        <resource>
                            <directory>${project.build.directory}/vendor-download</directory>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <!-- Baixa o Bootstrap Icons (CSS + fontes) direto do jsdelivr a
                 cada build, em vez de versionar os arquivos no git. Pra
                 atualizar: mudar version.bootstrap-icons no pom.xml raiz e
                 os sha256 correspondentes (o build falha se o arquivo
                 baixado nao bater com o hash esperado). -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>${version.download-maven-plugin}</version>
                <executions>
                    <execution>
                        <id>baixar-bootstrap-icons-css</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/bootstrap-icons@${version.bootstrap-icons}/font/bootstrap-icons.css</url>
                            <outputDirectory>${project.build.directory}/vendor-download/vendor/bootstrap-icons</outputDirectory>
                            <outputFileName>bootstrap-icons.css</outputFileName>
                            <sha256>${bootstrap-icons.css.sha256}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>baixar-bootstrap-icons-woff</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/bootstrap-icons@${version.bootstrap-icons}/font/fonts/bootstrap-icons.woff</url>
                            <outputDirectory>${project.build.directory}/vendor-download/vendor/bootstrap-icons/fonts</outputDirectory>
                            <outputFileName>bootstrap-icons.woff</outputFileName>
                            <sha256>${bootstrap-icons.woff.sha256}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>baixar-bootstrap-icons-woff2</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://cdn.jsdelivr.net/npm/bootstrap-icons@${version.bootstrap-icons}/font/fonts/bootstrap-icons.woff2</url>
                            <outputDirectory>${project.build.directory}/vendor-download/vendor/bootstrap-icons/fonts</outputDirectory>
                            <outputFileName>bootstrap-icons.woff2</outputFileName>
                            <sha256>${bootstrap-icons.woff2.sha256}</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Aplica as migrations do banco (mvn flyway:migrate manual, ou
                 automaticamente dentro do profile e2e - ver <profiles>
                 abaixo). -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${version.flyway}</version>
                <configuration>
                    <url>jdbc:postgresql://localhost:5432/bpm</url>
                    <user>${APP_DB_USER}</user>
                    <password>${APP_DB_PASSWORD}</password>
                    <locations>
                        <location>classpath:db/migration</location>
                    </locations>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${version.postgresql}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${version.flyway}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Executa/empacota a aplicacao no Open Liberty (mvn liberty:dev /
                 liberty:run pra uso manual, primeiro plano). O profile e2e
                 (ver <profiles> abaixo) adiciona execucoes start/stop pros
                 testes end-to-end. -->
            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
                <version>${version.liberty-maven-plugin}</version>
                <configuration>
                    <!-- Copia o driver JDBC para lib/global do servidor antes de iniciar,
                         no local referenciado pelo <library> em server.xml -->
                    <copyDependencies>
                        <dependencyGroup>
                            <location>lib/global</location>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                            </dependency>
                        </dependencyGroup>
                    </copyDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Testes end-to-end (src/e2e-test/java/.../e2e/*IT.java, Playwright):
             isolados num profile em vez de ligados direto no build, porque
             a fase verify (onde o maven-failsafe-plugin roda) vem ANTES de
             install no ciclo de vida padrao do Maven - sem isolar, todo
             "mvn install" (inclusive com -DskipTests, que so pula a
             EXECUCAO dos testes, nao as fases) subiria/derrubaria um
             Liberty de verdade e exigiria Postgres, so pra compilar. Pelo
             mesmo motivo o codigo fonte fica fora de src/test/java (sempre
             compilado): sem isso, so *compilar* o projeto sem o profile
             ja falharia por falta dos pacotes junit-jupiter/playwright
             (dependencias abaixo, so presentes com o profile ativo).
             Ativar com "mvn verify -Pe2e" (ver BUILD.md). Precisa do
             Postgres local rodando e de APP_DB_USER/APP_DB_PASSWORD no
             ambiente, igual ao liberty:run manual. -->
        <profile>
            <id>e2e</id>
            <dependencies>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>com.microsoft.playwright</groupId>
                    <artifactId>playwright</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${version.build-helper-plugin}</version>
                        <executions>
                            <execution>
                                <id>adicionar-fonte-dos-testes-e2e</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/e2e-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>migrar-antes-dos-testes-e2e</id>
                                <!-- pre-integration-test, antes do liberty:start
                                     logo abaixo: precisa do schema pronto antes
                                     da aplicacao subir. Idempotente. -->
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>migrate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.openliberty.tools</groupId>
                        <artifactId>liberty-maven-plugin</artifactId>
                        <executions>
                            <!-- liberty:start sozinho nao cria o servidor, nao
                                 resolve as features do server.xml nem copia o
                                 bpm.war pro servidor (diferente de liberty:run/
                                 dev, que encadeiam create + install-feature +
                                 deploy por baixo dos panos) - sem estes passos
                                 o servidor "inicia" sem feature nenhuma
                                 instalada (webProfile-11.0 incluso) e/ou sem a
                                 aplicacao implantada (CWWKZ0014W: aplicativo
                                 nao encontrado em bpm.war, mesmo com a porta
                                 HTTP respondendo), apesar do log dizer
                                 "pronto". -->
                            <execution>
                                <id>criar-servidor-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>create</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>resolver-features-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>install-feature</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>implantar-war-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>deploy</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>subir-servidor-antes-dos-testes-e2e</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>derrubar-servidor-depois-dos-testes-e2e</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
