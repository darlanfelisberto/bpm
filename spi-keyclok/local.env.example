# Copie para local.env. Este arquivo e usado apenas pelo Keycloak local.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

# Banco externo do Sistema-DCLC/auth. Use uma conta com SELECT apenas.
KC_DB_KIND_SIGSTORE=postgres
KC_DB_URL_FULL_SIGSTORE=jdbc:postgresql://localhost:5432/substitua-o-nome-do-banco
KC_DB_USERNAME_SIGSTORE=usuario_leitura
KC_DB_PASSWORD_SIGSTORE=troque-esta-senha

# Deve coincidir com OIDC_CLIENT_SECRET no bpm-app/.env.
BPM_CLIENT_SECRET=troque-por-um-segredo-aleatorio
